<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup Label="EmulatorsDependencySelection">
    <!-- Select one SDL version for a complete clean rebuild of the solution. -->
    <EmulatorsSDLVersion Condition="'$(EmulatorsSDLVersion)' == ''">3</EmulatorsSDLVersion>
  </PropertyGroup>
  <PropertyGroup Label="EmulatorsRuntimeDeployment">
    <!-- Runtime DLLs are deployed manually. -->
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
  </PropertyGroup>
</Project>
