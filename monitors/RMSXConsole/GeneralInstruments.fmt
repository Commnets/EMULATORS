#Formats Associated to General Instruments Commands
#(C) 2026 Ignacio Cea Fornies
?./Standard.fmt
#---
;AY38910Voice
Id:@ID@, Active:@ACTIVE@
Active Wave:@WAVEACTIVE@, Wave Clock:@WAVESCLOCKVALUE@, Oscillator:@OSCILLATORVALUE@
->Waves:
@WAVES?{fmter=.CLASS,empty=no waves}\n@
#---
#---
;AY38910Envelope
Type:@TYPE@, Continue:@CONTINUE@, Attack:@ATTACK@, Alternate:@ALTERNATE@, Hold:@HOLD@
Level:@LEVEL@, Direction:@DIRECTION@, Holding:@HOLDING@
Frequency:@FREQUENCY@Hz, Cycles per Step:@CYCLESPERSTEP@
#---
#---
;AY38910Channel
Channel:@ID@
Envelope:@USEENVELOPE@, Tone Disabled:@TONEDISABLED@, Noise Disabled:@NOISEDISABLED@
Volume:@VOLUME@
#---
#---
;AY38910LibWrapper
@ATTRS?{key=YES,equal=:,empty=no attributes}\n@
Chip Frequency:@CHIPFREQUENCY@Hz, Sampling Frequency:@SAMPLINGFREQUENCY@Hz
->Control Registers:
@CONTROLREGISTERS{blocksize=16,listsep=\,,tablesep=\ ,minsize=2}@
->Mixer Channels:
@CHANNELS?{fmter=AY38910Channel,empty=no channels,indent=\t}\n---\n@
->Shared Envelope:
@AY38910Envelope>@
->Voices:
@VOICES?{fmter=.CLASS,empty=no voices,indent=\t}\n---\n@
#---
#---
;AY38910Registers
Selected Register:$@SELECTEDREGISTER@
->Control Registers:
@CONTROLREGISTERS{blocksize=16,listsep=\,,tablesep=\ ,minsize=2}@
Port A: Input=$@PORTAINPUT@, Latch=$@PORTAOUTPUTLATCH@, Value=$@PORTAVALUE@, Output=@PORTAOUTPUT@
Port B: Input=$@PORTBINPUT@, Latch=$@PORTBOUTPUTLATCH@, Value=$@PORTBVALUE@, Output=@PORTBOUTPUT@
Last Value Read:$@LASTVALUEREAD@
#---
#---
;AY38910
Id:@ID@
@ATTRS?{key=YES,equal=:,empty=no attributes}\n@
->AY-3-8910 Registers:
@AY38910Registers>@
->Sound Wrapper:
@AY38910LibWrapper>@
#---
#---
;MSXAY38910
Id:@ID@
@ATTRS?{key=YES,equal=:,empty=no attributes}\n@
Joystick 1:$@JOYSTICK1@, Joystick 2:$@JOYSTICK2@
JIS Keyboard:@JISKEYBOARD@, Cassette Input:@CASSETTEINPUT@
->AY-3-8910 Registers:
@AY38910Registers>@
->Sound Wrapper:
@AY38910LibWrapper>@
#---