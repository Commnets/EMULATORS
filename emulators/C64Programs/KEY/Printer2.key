10 OPEN 4,4,7
20 PRINT#4, "PRUEBA DE LA IMPRESORA MPS-802"
30 PRINT#4, "-----------------------------"
40 PRINT#4, CHR$(14); :REM CAMBIO A MAYUSCULAS/MINUSCULAS
45 PRINT#4, "PRUEBA FORMATEADORES DE TEXTO:"
46 PRINT#4, "COL 1"; CHR$(9); "COL 2"; CHR$(9); "COL 3" :REM TABULADOR CHR$(9)
47 PRINT#4, "ALINEADO A LA DERECHA:"; CHR$(31); "TEXTO" :REM JUSTIFICAR CHR$(31)
48 PRINT#4, "-----------------------------"
50 PRINT#4, "abcdefghijklmnopqrstuvwxyz"
60 PRINT#4, CHR$(142); :REM VUELTA A MAYUSCULAS/GRAFICOS
70 PRINT#4, "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
80 PRINT#4, "0123456789 !@#$%^&*()_+-=[]"
81 PRINT#4, "-----------------------------"
82 PRINT#4, "PRUEBA FORMATEADORES NUMERICOS:"
83 OPEN 5,4,1 :REM LA DIRECCION SECUNDARIA 1 ACTIVA EL MODO FORMATO
84 PRINT#5, "$##,###.##"; 1234.56 :REM FORMATEA NUMERO CON MASCARA
85 PRINT#5, "  ####.##"; 78.9 :REM FORMATEA ALINEANDO EL DECIMAL
86 CLOSE 5
90 FOR I=1 TO 5:PRINT#4, :NEXT I :REM 5 LINEAS EN BLANCO
100 PRINT#4, CHR$(12); :REM SALTO DE PAGINA (FORM FEED)
110 CLOSE 4
