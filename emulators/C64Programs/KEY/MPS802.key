10 OPEN 4,4,7
20 CMD 4
30 PRINT "IMPRESORA COMMODORE MPS-802"
45 REM Cambiar a modo expandido (letras anchas)
50 PRINT CHR$(14);CHR$(28); "TEXTO AMPLIADO"
60 PRINT CHR$(20); "Texto normal"
75 REM Impresion de caracteres semigraficos del C64
80 FOR X=1 TO 5
90 PRINT "Q W E R T Y U I O P"
100 PRINT "A S D F G H J K L"
110 NEXT X
120 PRINT CHR$(13)
130 CLOSE 4
