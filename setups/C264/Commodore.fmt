#Formats Associated to Commodore Commands
#(C) 2022 Ignacio Cea Fornies
?./Standard.fmt
#---
;IRQInterrupt
Type:IRQ, Id:@ID{length=2}@, Active:@ACTIVE{length=3}@, In Execution:@EXECUTION{length=3}@, At Address:$@ADDRESS{length=5}@ (Requested:@REQCLOCK{length=10}@, Executed:@EXECCLOCK{length=10}@)
#---
#---
;NMIInterrupt
Type:NMI, Id:@ID{length=2}@, Active:@ACTIVE{length=3}@, In Execution:@EXECUTION{length=3}@, At Address:$@ADDRESS{length=5}@ (Requested:@REQCLOCK{length=10}@, Executed:@EXECCLOCK{length=10}@)
#---
#---
;Registers
@BYTES{blocksize=16,listsep=\,,tablesep=\ ,minsize=2}@
#---
#---
;RasterX
Position:@POSITION@(@POSITION0@)
First:@FIRST@, Last:@LAST@
#---
#---
;RasterY
Position:@POSITION@(@POSITION0@)
First:@FIRST@, Last:@LAST@
#---
#---
;Raster
->Raster Horizontal:
@RasterX>@
->Raster Vertical:
@RasterY>@
#---
#---
;BorderColor
(@COLOR@,@LUMINANCE@)
#---
#---
;BkColor1
(@COLOR@,@LUMINANCE@)
#---
#---
;BkColor2
(@COLOR@,@LUMINANCE@)
#---
#---
;BkColor3
(@COLOR@,@LUMINANCE@)
#---
#---
;BkColor4
(@COLOR@,@LUMINANCE@)
#---
#---
;GraphicalInfo
Raster:@RASTERY@,@RASTERX@
Character Position:@CHARPOS@
#---
#---
;TEDTimer1
Run Mode:@RUN@
IRQ:@IRQ@
Value:@VALUE@(@RELOADVALUE@)
#---
#---
;TEDTimer2
Run Mode:@RUN@
IRQ:@IRQ@
Value:@VALUE@(@RELOADVALUE@)
#---
#---
;TEDTimer3
Run Mode:@RUN@
IRQ:@IRQ@
Value:@VALUE@(@RELOADVALUE@)
#---
#---
;TEDRegisters
@BYTES{blocksize=16,listsep=\,,tablesep=\ ,minsize=2}@
Graphic Mode:@MODE@
40 Columns:@40C@, 25 Rows:@25R@
Cursor Position:@CURSOR@
ScrollX:@SCROLLX@, ScrollY:@SCROLLY@
Single Clock Mode:@SINGLECLK@
Border Color:@BorderColor>@
Colors:@BkColor1>@, @BkColor2>@, @BkColor3>@, @BkColor4>@
Memory:Screen($@SCREENADDRESS@), Chars($@CHARADDRESS@, ROM=@CHARSINROM@), Attributes($@ATTRIBUTEADDRESS@), Bitmap($@BITMAPADDRESS@)
IRQ:@IRQ@(@IRQLINE@)
->Current graphical position:
@GraphicalInfo>@
#---
#---
;Sound
@SoundLibWrapper>@
#---
#---
;TED
Id:@ID@
@ATTRS?{key=YES,equal=:,empty=no attributes}\n@
->TEDRegisters:
@TEDRegisters>@
@Raster>@
->Timer 1:
@TEDTimer1>@
->Timer 2:
@TEDTimer2>@
->Timer 3:
@TEDTimer3>@
->Sound:
@Sound>@
#---
#---
;VICIVoice
Id:@ID@, Active:@ACTIVE@
@WAVES?{fmter=.CLASS,empty=no waves}\n@
#---
#---
;VICISoundFunction
@SoundLibWrapper>@
#---
#---
;VICIRegisters
@BYTES{blocksize=16,listsep=\,,tablesep=\ ,minsize=2}@
LIGHTPEN:@LIGHTPENX@,@LIGHTPENY@
Colors:@AUXCOLOR@(@BKCOLOR@,@BRDCOLOR@)
Memory:Chars($@CHARADDRESS@), Screen($@SCREENADDRESS@), Colour($@COLOURADDRESS@)
#---
#---
;VICI
Id:@ID@
@ATTRS?{key=YES,equal=:,empty=no attributes}\n@
->VICIRegisters:
@VICIRegisters>@
@Raster>@
->Sound:
@VICISoundFunction>@
#---
#---
;SpriteInfo
(@ID@):\tEnabled:@ENABLED@\tX:@X@,Y:@Y@\tWidth:@DOUBLEW@,Height:@DOUBLEW@\tColor:@COLOR@(@MULTICOLOR@)\tPriority:@PRIORITY@
#---
#---
;VICIIRegisters
@BYTES{blocksize=16,listsep=\,,tablesep=\ ,minsize=2}@
Active:@ACTIVE@
Blank:@BLANK@
Graphic Mode:@MODE@
40 Columns:@40C@, 25 Rows:@25R@
ScrollX:@SCROLLX@, ScrollY:@SCROLLY@
LIGHTPEN:@LIGHTPENX@,@LIGHTPENY@
Colors:@FORECOLOR@(@BKCOLOR1@,@BKCOLOR2@,@BKCOLOR3@,@BKCOLOR4@)
Bank:@BANK@
Memory:Chars($@CHARADDRESS@), Screen($@SCREENADDRESS@), Bitmap($@BITMAPADDRESS@), Sprites($@SPRITEADDRESS@)
IRQ:@IRQ@(@IRQLINE@)
->Sprites:
@SPRITES?{fmter=.CLASS,empty=no sprites}\n@
#---
#---
;VICIIInternal
VCBASE:@VCBASE@, VC:@VC@, RC:@RC@, ROW:@ROW@, IDLE:@IDLE@
#---
#---
;VICII
Id:@ID@
@ATTRS?{key=YES,equal=:,empty=no attributes}\n@
->VICIIRegisters:
@VICIIRegisters>@
@Raster>@
->Badline:
Current Cycle:@Cycle@
DEN:@DENSeenAtLine30@
Condition:@BadlineCondition@ 
Detected:@BadlineDetected@
BA Requested:@BadlineBARequested@
BA Cycle:@BadlineBARequestCycle@
First CAccess:@BadlineFirstCAccessCycle@
CAccess:@BadlineCAccess@
CAccess Cycle:@BadlineCAccessStartCycle@
@VICIIInternal>@
